# ─────────────────────────────────────────────
# Omoikane Innovations — Backend Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit the actual .env file to version control.

# ── Server ──
SERVER_PORT=8080

# ── PostgreSQL Database ──
DATABASE_URL=jdbc:postgresql://localhost:5432/omoikane
DATABASE_USERNAME=omoikane
DATABASE_PASSWORD=your_secure_password_here

# ── CORS ──
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Resend Email (optional) ──
# Leave blank to disable confirmation emails.
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender in your Resend account.
# For testing without a verified domain, use: onboarding@resend.dev
# (only delivers to the account owner's email address)
RESEND_FROM_EMAIL=
# Sender name shown in outgoing emails
RESEND_FROM_NAME=Omoikane Innovations

# ── Rate Limiting ──
# Max contact submissions per IP per minute
RATE_LIMIT_RPM=5
